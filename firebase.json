{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.rules.example",
      "**/.*",
      "**/node_modules/**",
      "amorim_souza_site.zip",
      "CRM",
      "datajud-functions/**",
      "tests/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "datajud-functions",
      "codebase": "datajud-crm",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.test.js",
        "README.md",
        "fixtures"
      ]
    }
  ]
}
